    ensureAudio();
    var low = text.toLowerCase();
    if (/(more|unlimited|infinite|infinity|extra|100|a million|\d+) wishes/.test(low)) { genieSay("Ha! Nice try. You already get unlimited wishes here."); laugh(); return; }
    if (/\bgenie\b/.test(low) && /(free|be free)/.test(low)) { genieSay("Aww, thank you! But I like it here. Make another wish!"); return; }
    if (/\b(homework|chores)\b/.test(low)) { rain(DICT.confetti, 30); genieSay("Done! Your " + (/chores/.test(low) ? "chores are" : "homework is") + " finished. (Don't tell your teacher.)"); count1(); return; }

    var res = parse(text);
    if (!res.items.length) {
      var word = res.unknown.join(" ");
      spawn({ type: "mystery", emoji: ["🎁"], name: "gift" }, {});
      things[things.length - 1].type = "mystery"; things[things.length - 1].el.classList.add("mystery");
      genieSay(word ? "Hmm, I don't know how to make \"" + word + "\" yet. Here's a mystery gift instead. Click it!" : "Here's a mystery gift. Click it!", 5200);
      chime(); count1(); return;
    }
    var made = [], capped = false, newDrive = null;
    res.items.forEach(function (it) {
      var e = it.entry;
      if (e.type === "sky") { setSky(e.emoji[0]); made.push(e.emoji[0] === "fireworks" ? "fireworks" : e.name === "night" ? "night time" : e.name === "day" ? "sunshine" : e.name); return; }
      if (e.type === "rain") { var n = it.countGiven ? Math.min(Math.max(it.count, 6), 60) : 40; rain(e, n); made.push(e.name === "rich" || e.name === "money" ? "money" : e.name + "s"); return; }
      var count = Math.min(it.count, 30); if (it.count > 30) capped = true;
      for (var i = 0; i < count; i++) {
        var th = spawn(e, { size: it.size, color: it.color });
        if ((e.type === "drive" || e.type === "flyer") && !newDrive) newDrive = th;
      }
      made.push(label({ name: it.word || e.name }, count,it.size > 1.5 ? "giant" : it.size && it.size < 1 ? "tiny" : ""));
    });
    if (newDrive) { select(newDrive); input.blur(); }
    var line = pick(GRANTS) + " " + listify(made).replace(/^./, function (c) { return c.toUpperCase(); }) + " for you" + (name ? ", " + name : "") + "!";
    if (capped) line += " (I made as many as would fit.)";
    if (newDrive) line += newDrive.type === "flyer" ? " Use the arrow keys to fly." : " Use the arrow keys to drive.";
    genieSay(line);
    chime(); count1();
  }
  function listify(a) { if (a.length <= 1) return a.join(""); return a.slice(0, -1).join(", ") + " and " + a[a.length - 1]; }
  function count1() { granted++; nEl.textContent = granted; try { localStorage.setItem("genieWishes", String(granted)); } catch (e) {} }

  document.getElementById("wishform").addEventListener("submit", function (e) { e.preventDefault(); makeWish(input.value); input.value = ""; });
  document.querySelectorAll(".chip").forEach(function (c) { c.addEventListener("click", function () { makeWish(c.textContent); }); });
  document.getElementById("clear").addEventListener("click", function () {
    while (things.length) kill(things[0]);
    setSky("dusk");
    weatherUntil = 0; fireworksUntil = 0; drops = [];
    genieSay("All clean! What do you wish for next?");
  });

  // ---------- sounds (start after the first wish, since browsers need a click first) ----------
  var ac = null;
  function ensureAudio() { if (!ac) { try { ac = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} } if (ac && ac.state === "suspended") ac.resume(); }
  function tone(freq, dur, type, vol, when, slide) {
    if (!ac) return; var t = ac.currentTime + (when || 0), o = ac.createOscillator(), v = ac.createGain();
    o.type = type || "sine"; o.frequency.setValueAtTime(freq, t); if (slide) o.frequency.exponentialRampToValueAtTime(slide, t + dur);
    v.gain.setValueAtTime(vol || .12, t); v.gain.exponentialRampToValueAtTime(.0001, t + dur);
    o.connect(v); v.connect(ac.destination); o.start(t); o.stop(t + dur + .02);
  }
  function chime() { [784, 988, 1175, 1568].forEach(function (f, i) { tone(f, .35, "triangle", .08, i * .07); }); }
  function sparkle() { tone(1400, .15, "triangle", .06); tone(1900, .15, "triangle", .05, .06); }
  function honk() { ensureAudio(); tone(370, .18, "square", .06); tone(466, .18, "square", .05); }
  function vroom() { ensureAudio(); tone(90, .4, "sawtooth", .06, 0, 180); }
  function chomp() { ensureAudio(); tone(200, .08, "square", .06, 0, 80); }
  function boing() { ensureAudio(); tone(180, .35, "sine", .12, 0, 520); }
  function boom() { tone(120, .5, "sawtooth", .03, 0, 40); }
  function thunder() { tone(60, 1.2, "sawtooth", .05, 0, 30); }
  function laugh() { [520, 470, 520, 470, 420].forEach(function (f, i) { tone(f, .12, "triangle", .07, i * .12); }); }

  // ---------- start ----------
  addEventListener("resize", resize);
  resize();
  requestAnimationFrame(frame);
  setTimeout(function () { genieSay((name ? "Hello, " + name + "! " : "Hello! ") + "I'm the genie. Type any wish, like \"I want a car\", and I'll make it come true.", 7000); }, 300);
})();
</script>
