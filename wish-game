    var list = words.split(","), entry = { type: type, emoji: emoji.split("|"), name: list[0] };
    if (extra) for (var k in extra) entry[k] = extra[k];
    list.forEach(function (w) { DICT[w.trim()] = entry; });
    if (type !== "sky") ALL.push(entry);
