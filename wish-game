<style>
/* Same night-sky arcade look: slim top bar, a little world in the middle, the wish box at the bottom. */
:root{--bg:#05050f;--ink:#f3f5ff;--dim:#9aa3c9;--pink:#ec4899;--violet:#a855f7;--gold:#fbbf24;--gold-2:#f59e0b;--teal:#2dd4bf;
  --font-display:"Bungee","Impact","Arial Black",sans-serif;--font-ui:"Chakra Petch","Segoe UI",system-ui,sans-serif;
  --emoji:"Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif;color-scheme:dark}
*{box-sizing:border-box}
html,body{height:100%;margin:0;overflow:hidden}
body{background:var(--bg);color:var(--ink);font-family:var(--font-ui);display:flex;flex-direction:column}
#bar{position:relative;z-index:5;width:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;
  padding:8px max(14px,env(safe-area-inset-right,0px)) 8px max(14px,env(safe-area-inset-left,0px))}
#bar a{justify-self:start;color:var(--ink);text-decoration:none;font-weight:700;font-size:14px;letter-spacing:.06em;
  padding:6px 12px;border-radius:8px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06)}
#bar a:hover,#bar a:focus-visible{border-color:var(--gold);outline:none}
#bar h1{margin:0;font-family:var(--font-display);font-weight:400;font-size:clamp(16px,3.2vw,26px);white-space:nowrap;
  background:linear-gradient(180deg,#fff 15%,#fde68a 55%,var(--gold-2));-webkit-background-clip:text;background-clip:text;color:transparent}
#who{justify-self:end;font-weight:700;font-size:13px;letter-spacing:.08em;color:var(--dim);white-space:nowrap}
#who b{color:#fde68a}

/* the world */
#stage{position:relative;flex:1;min-height:0;overflow:hidden;touch-action:none}
.sky{position:absolute;inset:0;opacity:0;transition:opacity 1.2s}
.sky.on{opacity:1}
#sky-dusk{background:linear-gradient(180deg,#0b0726 0%,#2a0f4a 55%,#5b1f5f 100%)}
#sky-day{background:linear-gradient(180deg,#3aa0ff 0%,#8fd3ff 70%,#d8f1ff 100%)}
#sky-night{background:linear-gradient(180deg,#010108 0%,#0a0b25 70%,#151838 100%)}
#sky-storm{background:linear-gradient(180deg,#1b1f2a 0%,#2f3645 70%,#454d5e 100%)}
#moon{position:absolute;right:9%;top:8%;width:56px;height:56px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fffbe6,#f5e7a8 60%,#cdbb6a);
  box-shadow:0 0 50px rgba(255,240,180,.5);transition:opacity 1.2s,background 1.2s}
#stage[data-sky="day"] #moon{background:radial-gradient(circle,#fff7c2,#ffd23f 60%,#ffb703);box-shadow:0 0 80px rgba(255,210,63,.8)}
#stage[data-sky="storm"] #moon{opacity:0}
#rainbow{position:absolute;left:50%;top:6%;width:min(900px,120%);aspect-ratio:2/1;max-width:none;transform:translateX(-50%);border-radius:50% 50% 0 0/100% 100% 0 0;
  background:radial-gradient(circle at 50% 100%,transparent 52%,#a855f7 52% 55%,#3b82f6 55% 58%,#22c55e 58% 61%,#facc15 61% 64%,#f97316 64% 67%,#ef4444 67% 70%,transparent 70%);
  opacity:0;transition:opacity 1.5s;pointer-events:none}
#rainbow.on{opacity:.8}
#ground{position:absolute;left:0;right:0;bottom:0;height:34%;background:linear-gradient(180deg,#3b1d5e 0%,#24123f 100%);border-top:3px solid #7c3aed;transition:background 1s}
#stage[data-sky="day"] #ground{background:linear-gradient(180deg,#5fd35a 0%,#2f9b3a 100%);border-top-color:#86efac}
#stage[data-sky="night"] #ground{background:linear-gradient(180deg,#1c2a3a 0%,#0e1622 100%);border-top-color:#334155}
#stage[data-sky="storm"] #ground{background:linear-gradient(180deg,#3f4a3a 0%,#263022 100%);border-top-color:#64748b}
#snowcap{position:absolute;inset:0;background:linear-gradient(180deg,#f8fbff 0%,#dbe7f5 100%);opacity:0;transition:opacity 4s}
#snowcap.on{opacity:.92}
#fx{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3000}
#flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:3001}

.thing{position:absolute;left:0;top:0;line-height:1;user-select:none;-webkit-user-select:none;cursor:pointer;will-change:transform;font-family:var(--emoji)}
.thing .e{display:inline-block;transition:transform .12s}
.thing.sel::after{content:"";position:absolute;left:5%;right:5%;bottom:-.08em;height:.18em;border-radius:50%;
  background:radial-gradient(closest-side,rgba(251,191,36,.95),rgba(251,191,36,0));animation:pulse 1s ease-in-out infinite}
@keyframes pulse{50%{opacity:.4}}
.rainbowfx{animation:hue 2s linear infinite}
@keyframes hue{to{filter:hue-rotate(360deg) drop-shadow(0 0 8px #fff)}}
.mystery .e{animation:shake 1.4s ease-in-out infinite}
@keyframes shake{0%,70%,100%{transform:rotate(0)}75%{transform:rotate(-12deg)}85%{transform:rotate(12deg)}}
.pop{position:absolute;z-index:3002;pointer-events:none;font:700 18px var(--font-display);color:#fff;text-shadow:0 2px 0 #000,0 0 12px rgba(0,0,0,.6);
  white-space:nowrap;transform:translate(-50%,-100%);animation:rise 1.1s ease-out forwards}
@keyframes rise{to{transform:translate(-50%,-260%);opacity:0}}

/* the genie */
#genie{position:absolute;left:max(14px,env(safe-area-inset-left,0px));bottom:12px;z-index:3003;display:flex;align-items:flex-end;gap:8px;pointer-events:none;max-width:calc(100% - 28px)}
#genie .lamp{font-family:var(--emoji);font-size:44px;line-height:1;filter:drop-shadow(0 0 14px rgba(251,191,36,.7))}
#genie .who{font-family:var(--emoji);font-size:52px;line-height:1;position:absolute;left:2px;bottom:34px;opacity:0;transform:translateY(20px) scale(.4);transition:all .35s cubic-bezier(.3,1.6,.6,1)}
#genie.up .who{opacity:1;transform:none}
#bubble{margin-bottom:36px;max-width:min(420px,72vw);padding:10px 14px;border-radius:14px 14px 14px 4px;background:rgba(10,8,30,.88);border:2px solid var(--gold);
  font-size:15px;line-height:1.35;font-weight:700;color:#fff7d6;box-shadow:0 6px 24px rgba(0,0,0,.4)}
#bubble[hidden]{display:none!important}

/* driving hint + touch pad */
#drivehint{position:absolute;top:10px;left:50%;transform:translateX(-50%);z-index:3003;padding:6px 12px;border-radius:999px;background:rgba(10,8,30,.75);
  border:1px solid rgba(251,191,36,.5);font-size:13px;font-weight:700;letter-spacing:.04em;color:#fde68a;white-space:nowrap;max-width:calc(100% - 28px);overflow:hidden;text-overflow:ellipsis}
#pad{position:absolute;right:max(14px,env(safe-area-inset-right,0px));bottom:14px;z-index:3003;display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(2,48px);gap:6px}
#pad button{font:700 20px var(--font-ui);color:#fff;background:rgba(10,8,30,.7);border:2px solid rgba(251,191,36,.6);border-radius:12px;touch-action:none}
#pad button:active{background:rgba(251,191,36,.35)}
#pad .u{grid-column:2;grid-row:1}#pad .l{grid-column:1;grid-row:2}#pad .d{grid-column:2;grid-row:2}#pad .r{grid-column:3;grid-row:2}#pad .h{grid-column:3;grid-row:1;font-size:12px}
@media (pointer:fine){#pad{display:none}}

/* wish box */
#wishbar{position:relative;z-index:5;display:grid;gap:10px;padding:12px max(16px,env(safe-area-inset-right,0px)) max(12px,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));
  background:linear-gradient(180deg,#120a2a,#08061a);border-top:2px solid rgba(251,191,36,.35)}
#wishform{display:flex;gap:10px;width:min(820px,100%);margin:0 auto}
#wish{flex:1;min-width:0;font:700 18px var(--font-ui);color:var(--ink);background:#0d0a24;border:2px solid rgba(168,85,247,.6);border-radius:12px;padding:12px 14px}
#wish::placeholder{color:#6f6a99}
#wish:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(251,191,36,.25)}
#go{font:400 16px var(--font-display);letter-spacing:.04em;color:#2a1600;background:linear-gradient(180deg,#fde68a,var(--gold) 50%,var(--gold-2));border:0;border-radius:12px;padding:0 18px;cursor:pointer;
  box-shadow:0 4px 0 #92400e;white-space:nowrap}
#go:active{transform:translateY(2px);box-shadow:0 2px 0 #92400e}
#go:focus-visible,.chip:focus-visible,#clear:focus-visible{outline:2px solid #fff;outline-offset:2px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;width:min(820px,100%);margin:0 auto}
.chip,#clear{font:700 13px var(--font-ui);color:var(--ink);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:6px 12px;cursor:pointer}
.chip:hover{border-color:var(--gold)}
#clear{color:#fca5a5;border-color:rgba(252,165,165,.35)}
#count{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);font-weight:700}
#count b{color:#fde68a;font-variant-numeric:tabular-nums}
@media (max-width:560px){#bar h1{display:none}#bar{grid-template-columns:1fr 1fr}#go{padding:0 12px;font-size:14px}.chip.x{display:none}}
@media (prefers-reduced-motion:reduce){.thing.sel::after,.mystery .e,.rainbowfx{animation:none}.sky,#rainbow{transition:none}}
</style>
</head>
<body>
<header id="bar">
  <a href="arcade.html">&larr; Games</a>
  <h1>Genie Wish</h1>
  <span id="who"></span>
</header>

<main id="stage" data-sky="dusk">
  <div class="sky on" id="sky-dusk"></div>
  <div class="sky" id="sky-day"></div>
  <div class="sky" id="sky-night"></div>
  <div class="sky" id="sky-storm"></div>
  <div id="moon"></div>
  <div id="rainbow"></div>
  <div id="ground"><div id="snowcap"></div></div>
  <canvas id="fx"></canvas>
  <div id="flash"></div>
  <div id="drivehint" hidden></div>
  <div id="genie"><span class="who" aria-hidden="true">🧞</span><span class="lamp" aria-hidden="true">🪔</span><div id="bubble" role="status"></div></div>
  <div id="pad" hidden>
    <button type="button" class="u" data-k="ArrowUp" aria-label="Up">▲</button>
    <button type="button" class="l" data-k="ArrowLeft" aria-label="Left">◀</button>
    <button type="button" class="d" data-k="ArrowDown" aria-label="Down">▼</button>
    <button type="button" class="r" data-k="ArrowRight" aria-label="Right">▶</button>
    <button type="button" class="h" data-k=" " aria-label="Honk">BEEP</button>
  </div>
</main>

<footer id="wishbar">
  <form id="wishform" autocomplete="off">
    <label for="wish" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Your wish</label>
    <input id="wish" type="text" maxlength="120" placeholder="I wish for…  (try: I want a car)">
    <button id="go" type="submit">Make a wish</button>
  </form>
  <div class="row">
    <button type="button" class="chip">I want a car</button>
    <button type="button" class="chip">Give me 5 puppies</button>
    <button type="button" class="chip">I wish it would snow</button>
    <button type="button" class="chip x">A giant pizza</button>
    <button type="button" class="chip x">I want to be rich</button>
    <button type="button" class="chip x">A rocket and fireworks</button>
    <button type="button" id="clear">Clear world</button>
    <span id="count">Wishes granted <b id="n">0</b></span>
  </div>
</footer>

<script>
(function () {
  "use strict";
  // ---------- player name (shared with the rest of the arcade) ----------
  var player = null;
  try { player = JSON.parse(localStorage.getItem("arcadeSession") || "null"); } catch (e) {}
  var who = document.getElementById("who");
  if (player && player.name) { who.innerHTML = "Player <b></b>"; who.querySelector("b").textContent = String(player.name).toUpperCase(); }
  else who.textContent = "Playing as guest";
  var granted = 0;
  try { granted = parseInt(localStorage.getItem("genieWishes") || "0", 10) || 0; } catch (e) {}
  var nEl = document.getElementById("n"); nEl.textContent = granted;

  // ---------- the genie's dictionary ----------
  // type: drive (car you steer), flyer (you steer in the air), walk, fly, swim, bounce, eat, still, rain, sky
